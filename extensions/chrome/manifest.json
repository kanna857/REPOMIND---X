{
  "manifest_version": 3,
  "name": "RepoMind-X // GitHub AI Copilot",
  "version": "1.0.0",
  "description": "AI-powered open-source contribution companion directly on GitHub issues and PRs.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://github.com/*", "http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RepoMind-X Telemetry"
  }
}
